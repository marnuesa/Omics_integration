## 1-READING CX REPORTS COMING FROM BISMARK
files = list.files(CX_path, full.names = T)
files = files[grepl(".CX_report.txt", files, fixed = T)]
#Stressed_files = files[grepl(paste0(t, "-", s, "-"), files, fixed = T)]
